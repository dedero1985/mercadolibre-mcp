# MercadoLibre MCP Server - Environment Variables
# Copy this file to .env and fill in your credentials

# --- Required: MercadoLibre Application Credentials ---
# Create an app at: https://developers.mercadolibre.com/apps
# 1. Go to "Mis Aplicaciones" (My Applications)
# 2. Click "Crear aplicación" (Create Application)
# 3. Fill in the details and get your credentials

MERCADOLIBRE_CLIENT_ID=your_app_id_here
MERCADOLIBRE_CLIENT_SECRET=your_client_secret_here
MERCADOLIBRE_REDIRECT_URI=http://localhost:8080/callback

# --- Optional: Site Configuration ---
# Default site ID for all operations (can be overridden per tool call)
# Supported sites: MLA (Argentina), MLU (Uruguay), MLB (Brazil), MLM (Mexico),
#   MLC (Chile), MCO (Colombia), MPE (Peru), MEC (Ecuador), MLV (Venezuela),
#   MCR (Costa Rica), MPA (Panama), MRD (Dominican Rep.), MHN (Honduras),
#   MBO (Bolivia), MNI (Nicaragua), MPY (Paraguay), MSV (El Salvador), MGT (Guatemala)
MERCADOLIBRE_SITE_ID=MLA

# --- Optional: Server Configuration ---
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30